# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# MySQL (shared by all 4 services, separate tables per service)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=travel_booking
MYSQL_USER=travel_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Note: on the host machine (e.g. connecting with a MySQL client from Windows),
# this is published on port 3307 instead - see docker-compose.yml. Containers
# still talk to each other over the internal network on 3306, unaffected.

# Full SQLAlchemy connection string built from the values above.
# Services read this directly - see common/auth.py usage pattern in each database.py
DATABASE_URL=mysql+pymysql://travel_app:change_me_app_password@mysql:3306/travel_booking

# MongoDB (reviews collection only)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=travel_booking_reviews
MONGO_URL=mongodb://mongodb:27017

# JWT signing secret - used by common/auth.py to sign and verify tokens.
# Generate a real random value for production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Kafka (KRaft mode, single broker - see docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis (cache-aside for flight/hotel lookups - see docker-compose.yml)
REDIS_URL=redis://redis:6379/0
